<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/public/favicon.ico" type="image/x-icon">
    <title>방어 덱 목록</title>
    <link rel="stylesheet" href="/public/css/common/layout.css">
    <link rel="stylesheet" href="/public/css/style.css">
    <link rel="stylesheet" href="/public/css/game.css">
</head>
<body>
    <%- include('../partials/header') %>

    <main class="main-content">
        <div class="game-container">
            <div class="page-header">
                <h1 class="page-title">방어 덱 목록</h1>
<!--                <p class="page-desc">몬스터 이름으로 검색하여 방어 덱과 공략 정보를 확인하세요</p>-->
                <p class="page-desc">총 <strong><%= defenceCount %></strong>개의 방덱과 총 <strong><%= attackCount %></strong>개의 공덱이 등록되어 있습니다.</p>
                <% if (bestKeywords && bestKeywords.length > 0) { %>
                    <p class="page-desc best-keywords-row">
                        <span class="best-keywords-label">인기 검색어</span>
                        <% for (let i = 0; i < bestKeywords.length; i++) { %>
                            <button type="button" class="best-keyword-btn" onclick="applyBestKeyword('<%= bestKeywords[i].keyword %>')">
                                <span class="best-keyword-rank"><%= bestKeywords[i].keyword %></span>
                            </button>
                        <% } %>
                    </p>
                <% } %>

                <div style="display:flex; align-items:center; max-width:660px; margin:20px auto 0;">
                    <div class="search-container" style="flex:1; margin:0;">
                        <input type="text" class="search-input" id="pageSearchInput" placeholder="몬스터 이름 검색..." autocomplete="off">
                        <button type="button" class="reset-btn" id="pageResetBtn" aria-label="초기화" style="display: none;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </button>
                        <button type="button" class="search-btn" id="pageSearchBtn" aria-label="검색">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                        </button>
                    </div>
                    <button type="button" class="notice-toggle-btn" id="noticeToggleBtn">
                        <span class="notice-toggle-dot"></span>
                        <span id="noticeToggleLabel">공지</span>
                    </button>
                </div>
            </div>
            <div id="defenceList"></div>
        </div>
    </main>

    <script>
        function applyBestKeyword(keyword) {
            const input = document.getElementById('pageSearchInput');
            const resetBtn = document.getElementById('pageResetBtn');
            input.value = keyword;
            if (resetBtn) resetBtn.style.display = 'flex';
            const headerInput = document.getElementById('headerSearchInput');
            if (headerInput) headerInput.value = keyword;
            const url = new URL(window.location);
            url.searchParams.set('keyword', keyword);
            window.history.pushState({}, '', url);
            fetchDefenceList(keyword);
        }

        // 공지사항 토글
        let noticeOn = localStorage.getItem('noticeToggle') !== 'off';

        (function initNoticeToggle() {
            const btn = document.getElementById('noticeToggleBtn');
            const label = document.getElementById('noticeToggleLabel');

            function applyToggleUI() {
                btn.classList.toggle('on', noticeOn);
                label.textContent = noticeOn ? '공지 ON' : '공지 OFF';
            }

            applyToggleUI();

            btn.addEventListener('click', () => {
                noticeOn = !noticeOn;
                localStorage.setItem('noticeToggle', noticeOn ? 'on' : 'off');
                applyToggleUI();
                const kw = document.getElementById('pageSearchInput').value.trim();
                if (!kw) fetchDefenceList('');
            });
        })();

        // 페이지 검색 기능
        (function() {
            const pageSearchInput = document.getElementById('pageSearchInput');
            const pageSearchBtn = document.getElementById('pageSearchBtn');
            const pageResetBtn = document.getElementById('pageResetBtn');

            // 헤더 검색창 엘리먼트 (header.ejs에서 정의됨)
            const headerSearchInput = document.getElementById('headerSearchInput');
            const headerSearchBtn = document.getElementById('headerSearchBtn');

            if (pageSearchInput && pageSearchBtn) {
                const urlParams = new URLSearchParams(window.location.search);
                const keyword = urlParams.get('keyword');
                if (keyword) {
                    pageSearchInput.value = keyword;
                    if (headerSearchInput) headerSearchInput.value = keyword;
                    if (pageResetBtn) pageResetBtn.style.display = 'flex';
                }

                pageSearchInput.addEventListener('input', () => {
                    if (pageResetBtn) {
                        pageResetBtn.style.display = pageSearchInput.value.length > 0 ? 'flex' : 'none';
                    }
                });

                pageSearchInput.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter') {
                        executePageSearch();
                    }
                });

                pageSearchBtn.addEventListener('click', () => {
                    executePageSearch();
                });

                if (pageResetBtn) {
                    pageResetBtn.addEventListener('click', () => {
                        pageSearchInput.value = '';
                        pageResetBtn.style.display = 'none';
                        if (headerSearchInput) headerSearchInput.value = '';
                        executePageSearch();
                        pageSearchInput.focus();
                    });
                }

                // 헤더 검색창의 동작을 이 페이지의 로직으로 오버라이드
                if (headerSearchInput && headerSearchBtn) {
                    headerSearchInput.addEventListener('input', (e) => {
                        pageSearchInput.value = e.target.value;
                    });

                    headerSearchBtn.onclick = (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        executePageSearch();
                    };

                    headerSearchInput.onkeydown = (e) => {
                        if (e.key === 'Enter') {
                            e.preventDefault();
                            executePageSearch();
                        }
                    };
                }

                function executePageSearch() {
                    const kw = pageSearchInput.value.trim();
                    const url = new URL(window.location);
                    if (kw) {
                        url.searchParams.set('keyword', kw);
                    } else {
                        url.searchParams.delete('keyword');
                    }
                    window.history.pushState({}, '', url);
                    fetchDefenceList(kw);
                }
            }
        })();

        async function fetchDefenceList(keywordOverride) {
            try {
                const urlParams = new URLSearchParams(window.location.search);
                const keyword = keywordOverride !== undefined ? keywordOverride : (urlParams.get('keyword') || '');

                if (!keyword && noticeOn) {
                    fetchBoardList();
                    return;
                }

                const response = await fetch(`/api/game/defence?keyword=${encodeURIComponent(keyword)}`, {
                    method: 'GET',
                    credentials: 'include'
                });
                const data = await response.json();
                renderDefenceList(data.defenceList);
            } catch (error) {
                console.error('Failed to fetch defence list:', error);
            }
        }

        async function fetchBoardList() {
            try {
                const response = await fetch('/api/game/board', { credentials: 'include' });
                const data = await response.json();
                renderBoardList(data.boardList);
            } catch (error) {
                console.error('Failed to fetch board list:', error);
            }
        }

        function renderBoardList(boardList) {
            const container = document.getElementById('defenceList');
            if (!boardList || boardList.length === 0) {
                container.innerHTML = '<div class="no-results">등록된 공지사항이 없습니다.</div>';
                return;
            }

            container.innerHTML = boardList.map(board => {
                const files = (board.boardFileList || []).filter(f => f.delYn !== 'Y');
                const imagesHtml = files.length > 0 ? `
                    <div class="board-images">
                        ${files.map(f => `<img src="/public/image/board/${f.filePath}" alt="첨부 이미지" class="board-attach-img">`).join('')}
                    </div>` : '';
                return `
                <div class="defence-card" id="board-card-${board.boardId}" data-id="${board.boardId}" onclick="toggleBoardAccordion('${board.boardId}')">
                    <div class="card-header">
                        <div class="board-title-text">${board.boardTitle}</div>
                        <span class="chevron">▼</span>
                    </div>
                    <div class="accordion-body" id="board-body-${board.boardId}">
                        <div class="accordion-inner" id="board-inner-${board.boardId}">
                            <div class="board-meta-row">
                                <span class="board-author">${board.inputMember ? board.inputMember.nickname || board.inputMember.name : '-'}</span>
                                <span class="board-date">${board.inputDt ? new Date(board.inputDt).toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\. /g, '.').replace(/\.$/, '') : '-'}</span>
                            </div>
                            <div class="board-content-text">${(board.boardContent || '').replace(/\r\n/g, '\n').replace(/\r/g, '\n').trim()}</div>
                            ${imagesHtml}
                        </div>
                    </div>
                </div>`;
            }).join('');
        }

        function toggleBoardAccordion(boardId) {
            const card = document.getElementById(`board-card-${boardId}`);
            const body = document.getElementById(`board-body-${boardId}`);
            const isOpen = card.classList.contains('open');

            document.querySelectorAll('.defence-card.open').forEach(c => {
                c.classList.remove('open');
                const b = document.getElementById(`board-body-${c.dataset.id}`);
                if (b) b.style.maxHeight = null;
            });

            if (isOpen) return;

            card.classList.add('open');
            body.style.maxHeight = body.scrollHeight + 'px';
        }

        const sliderState = {};

        function renderDefenceList(defenceList) {
            const container = document.getElementById('defenceList');
            if (!defenceList || defenceList.length === 0) {
                container.innerHTML = '<div class="no-results">검색 결과가 없습니다.</div>';
                return;
            }

            container.innerHTML = defenceList.map(defence => `
                <div class="defence-card" id="card-${defence.defenceId}" data-id="${defence.defenceId}" onclick="toggleAccordion('${defence.defenceId}')">
                    <div class="card-header" >
                        <div class="monster-deck">
                            ${renderMonster(defence.defenceMonsterA)}
                            ${renderMonster(defence.defenceMonsterB)}
                            ${renderMonster(defence.defenceMonsterC)}
                        </div>
                        <div style="display:flex;align-items:center;gap:10px;">
                            <span class="attack-count">⚔ ${defence.attackCount}</span>
                            <span class="chevron">▼</span>
                        </div>
                    </div>
                    <div class="accordion-body" id="body-${defence.defenceId}">
                        <div class="accordion-inner" id="inner-${defence.defenceId}">
                            <div class="loading-inline">불러오는 중...</div>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        async function toggleAccordion(defenceId) {
            const card = document.getElementById(`card-${defenceId}`);
            const body = document.getElementById(`body-${defenceId}`);
            const isOpen = card.classList.contains('open');

            document.querySelectorAll('.defence-card.open').forEach(c => {
                c.classList.remove('open');
                document.getElementById(`body-${c.dataset.id}`).style.maxHeight = null;
            });

            if (isOpen) return;

            card.classList.add('open');
            body.style.maxHeight = body.scrollHeight + 'px';

            if (sliderState[defenceId]) {
                renderInlineSlider(defenceId);
                return;
            }

            try {
                const response = await fetch(`/api/game/defence/${defenceId}`, { credentials: 'include' });
                const data = await response.json();
                sliderState[defenceId] = { attackList: data.attackList || [], currentIndex: 0 };
                renderInlineSlider(defenceId);
                body.style.maxHeight = body.scrollHeight + 'px';
            } catch (e) {
                document.getElementById(`inner-${defenceId}`).innerHTML =
                    '<div class="no-attack-inline">데이터를 불러오지 못했습니다.</div>';
            }
        }

        function renderInlineSlider(defenceId) {
            const inner = document.getElementById(`inner-${defenceId}`);
            const state = sliderState[defenceId];
            const { attackList, currentIndex } = state;

            if (!attackList || attackList.length === 0) {
                inner.innerHTML = '<div class="no-attack-inline">등록된 공략 덱이 없습니다.</div>';
                return;
            }

            const currentDeck = attackList[currentIndex];
            const isFirst = currentIndex === 0;
            const isLast = currentIndex === attackList.length - 1;

            inner.innerHTML = `
                <div class="inline-slider-wrapper">
                    <div class="inline-attack-slider">
                        <div class="slider-header">
                            <div class="header-left">
                                <div class="section-label">공략 덱</div>
                                ${currentDeck.isCertify === 'Y'
                                    ? `<span style="display:inline-flex;align-items:center;gap:3px;color:#0300AA;background:rgba(3,0,170,0.08);border:1px solid rgba(3,0,170,0.25);border-radius:20px;font-size:11px;font-weight:600;padding:2px 8px;"><img src="/public/image/certify_sm.png" style="height:12px;">길드인증</span>`
                                    : `<span style="display:inline-flex;align-items:center;color:#E97300;background:rgba(233,115,0,0.08);border:1px solid rgba(233,115,0,0.25);border-radius:20px;font-size:11px;font-weight:600;padding:2px 8px;">일반공덱</span>`}
                            </div>
                            <div class="header-right">
                                <div class="pagination-info">${currentIndex + 1} / ${attackList.length}</div>
                                <div class="pagination-info">${currentDeck.inputMember.nickname}</div>
                                <div class="attack-date">${currentDeck.inputDt ? new Date(currentDeck.inputDt).toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\. /g, '.').replace(/\.$/, '') : '-'}</div>
                            </div>
                        </div>
                        <div class="attack-deck-content">
                            <div class="attack-monster-deck">
                                ${renderAttackMonsterPill(currentDeck.attackMonsterA)}
                                ${renderAttackMonsterPill(currentDeck.attackMonsterB)}
                                ${renderAttackMonsterPill(currentDeck.attackMonsterC)}
                            </div>
                            <div class="deck-desc-container">
                                ${currentDeck.deckDesc1
                                    ? `<div class="deck-desc-box">${currentDeck.deckDesc1.replace(/\n/g, '<br>')}</div>`
                                    : ''
                                }
                                ${currentDeck.deckDesc2
                                    ? `<div class="deck-desc-box">${currentDeck.deckDesc2.replace(/\n/g, '<br>')}</div>`
                                    : ''
                                }
                                ${!currentDeck.deckDesc1 && !currentDeck.deckDesc2
                                    ? '<div class="no-desc">설명이 없습니다.</div>'
                                    : ''
                                }
                            </div>
                        </div>
                        <div class="slider-nav-buttons">
                            <button class="slider-nav-btn" onclick="event.stopPropagation(); changeSliderPage('${defenceId}', -1)" ${isFirst ? 'disabled' : ''}>이전</button>
                            <button class="slider-nav-btn" onclick="event.stopPropagation(); changeSliderPage('${defenceId}', 1)" ${isLast ? 'disabled' : ''}>다음</button>
                        </div>
                    </div>
                </div>
            `;
        }

        function changeSliderPage(defenceId, direction) {
            const state = sliderState[defenceId];
            const newIndex = state.currentIndex + direction;
            if (newIndex >= 0 && newIndex < state.attackList.length) {
                state.currentIndex = newIndex;
                renderInlineSlider(defenceId);
                const body = document.getElementById(`body-${defenceId}`);
                body.style.maxHeight = body.scrollHeight + 'px';

                // 펼쳐진 defence 카드로 포커싱 이동 (header 높이 고려)
                const card = document.getElementById(`card-${defenceId}`);
                if (card) {
                    const header = document.querySelector('header');
                    const headerHeight = header ? header.offsetHeight : 0;
                    const cardTop = card.getBoundingClientRect().top + window.scrollY;
                    window.scrollTo({ top: cardTop - headerHeight - 10, behavior: 'smooth' });
                }
            }
        }

        function renderMonster(monster) {
            if (!monster || !monster.monsterName) return '';
            const typeIcon = monster.typeImg
                ? `<img class="monster-type-icon" src="/public/image/${monster.typeImg}" alt="${monster.typeName || ''}">`
                : '';

            return `
                <div class="monster-pill">
                    <span class="monster-name ${monster.typeColor || ''}">${typeIcon}${monster.monsterName}</span>
                </div>
            `;
        }

        function renderAttackMonsterPill(monster) {
            if (!monster || !monster.monsterName) return '';
            const typeIcon = monster.typeImg
                ? `<img class="monster-type-icon-sm" src="/public/image/${monster.typeImg}" alt="${monster.typeName || ''}">`
                : '';
            return `<div class="attack-monster-pill">${typeIcon}${monster.monsterName}</div>`;
        }

        fetchDefenceList();
    </script>
</body>
</html>

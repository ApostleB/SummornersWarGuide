<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/public/favicon.ico" type="image/x-icon">
    <title>방덱등록</title>
    <link rel="stylesheet" href="/public/css/common/layout.css">
    <link rel="stylesheet" href="/public/css/style.css">
    <link rel="stylesheet" href="/public/css/game.css">
</head>
<body>
<%- include('../partials/header') %>

<main class="main-content">
    <div class="game-container">
        <div class="page-header">
            <h1 class="page-title">방덱등록</h1>
            <p class="page-desc">새로운 방어덱과 공략덱을 등록 신청합니다</p>
        </div>

        <div class="register-form">
            <!-- 방덱 입력 -->
            <div class="form-section">
                <div class="section-title">
                    <span class="badge badge-defence">방덱</span>
                    방어덱 몬스터
                </div>
                <div class="monster-inputs">
                    <div class="monster-input-wrapper">
                        <label>몬스터 A (리더)<span class="required-mark">*</span></label>
                        <input type="text" class="monster-input" id="defenceMonsterA" placeholder="몬스터 이름" autocomplete="off">
                        <div class="suggestions" id="suggestionsDefenceA"></div>
                    </div>
                    <div class="monster-input-wrapper">
                        <label>몬스터 B<span class="required-mark">*</span></label>
                        <input type="text" class="monster-input" id="defenceMonsterB" placeholder="몬스터 이름" autocomplete="off">
                        <div class="suggestions" id="suggestionsDefenceB"></div>
                    </div>
                    <div class="monster-input-wrapper">
                        <label>몬스터 C<span class="required-mark">*</span></label>
                        <input type="text" class="monster-input" id="defenceMonsterC" placeholder="몬스터 이름" autocomplete="off">
                        <div class="suggestions" id="suggestionsDefenceC"></div>
                    </div>
                </div>
            </div>

            <!-- 공덱 입력 -->
            <div class="form-section">
                <div class="section-title">
                    <span class="badge badge-attack">공덱</span>
                    공략덱 몬스터
                </div>
                <div class="monster-inputs">
                    <div class="monster-input-wrapper">
                        <label>몬스터 A (리더)<span class="required-mark">*</span></label>
                        <input type="text" class="monster-input" id="attackMonsterA" placeholder="몬스터 이름" autocomplete="off">
                        <div class="suggestions" id="suggestionsAttackA"></div>
                    </div>
                    <div class="monster-input-wrapper">
                        <label>몬스터 B<span class="required-mark">*</span></label>
                        <input type="text" class="monster-input" id="attackMonsterB" placeholder="몬스터 이름" autocomplete="off">
                        <div class="suggestions" id="suggestionsAttackB"></div>
                    </div>
                    <div class="monster-input-wrapper">
                        <label>몬스터 C<span class="required-mark">*</span></label>
                        <input type="text" class="monster-input" id="attackMonsterC" placeholder="몬스터 이름" autocomplete="off">
                        <div class="suggestions" id="suggestionsAttackC"></div>
                    </div>
                </div>
            </div>

            <!-- 비고 입력 -->
            <div class="form-section">
                <div class="section-title">비고</div>
                <div class="desc-inputs">
                    <div class="desc-input-wrapper">
                        <label>비고 1</label>
                        <textarea class="desc-textarea" id="deckDesc1" placeholder="덱 설명, 룬 세팅 등"></textarea>
                    </div>
                    <div class="desc-input-wrapper">
                        <label>비고 2</label>
                        <textarea class="desc-textarea" id="deckDesc2" placeholder="추가 설명"></textarea>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="resetForm()">초기화</button>
                <button type="button" class="btn btn-primary" onclick="submitForm()">등록 신청</button>
            </div>
        </div>
    </div>
</main>

<script>
    let searchTimeout = null;

    // 자동완성 설정
    const inputIds = [
        'defenceMonsterA', 'defenceMonsterB', 'defenceMonsterC',
        'attackMonsterA', 'attackMonsterB', 'attackMonsterC'
    ];

    inputIds.forEach(id => {
        const input = document.getElementById(id);
        // defenceMonsterA -> DefenceA, attackMonsterB -> AttackB
        const suggestionId = 'suggestions' + id.replace('defenceMonster', 'Defence').replace('attackMonster', 'Attack');
        const suggestions = document.getElementById(suggestionId);

        input.addEventListener('input', (e) => {
            const keyword = e.target.value.trim();
            if (searchTimeout) clearTimeout(searchTimeout);

            if (keyword.length < 1) {
                suggestions.classList.remove('active');
                return;
            }

            searchTimeout = setTimeout(() => {
                searchMonsters(keyword, suggestions, input);
            }, 300);
        });

        input.addEventListener('blur', () => {
            setTimeout(() => {
                suggestions.classList.remove('active');
            }, 200);
        });

        input.addEventListener('focus', () => {
            if (suggestions.innerHTML && input.value.trim().length >= 1) {
                suggestions.classList.add('active');
            }
        });
    });

    async function searchMonsters(keyword, suggestionsEl, inputEl) {
        try {
            const response = await fetch(`/api/game/monsters/search?keyword=${encodeURIComponent(keyword)}`, {
                credentials: 'include'
            });
            const data = await response.json();

            if (data.monsters && data.monsters.length > 0) {
                suggestionsEl.innerHTML = data.monsters.map(m =>
                    `<div class="suggestion-item" onclick="selectMonster('${m}', '${inputEl.id}')">${m}</div>`
                ).join('');
                suggestionsEl.classList.add('active');
            } else {
                suggestionsEl.classList.remove('active');
            }
        } catch (error) {
            console.error('Failed to search monsters:', error);
        }
    }

    function selectMonster(name, inputId) {
        document.getElementById(inputId).value = name;
        const suggestionId = 'suggestions' + inputId.replace('defenceMonster', 'Defence').replace('attackMonster', 'Attack');
        document.getElementById(suggestionId).classList.remove('active');
    }

    function resetForm() {
        inputIds.forEach(id => {
            const el = document.getElementById(id);
            el.value = '';
            el.classList.remove('error');
        });
        document.getElementById('deckDesc1').value = '';
        document.getElementById('deckDesc2').value = '';
    }

    function validateRequiredFields() {
        const requiredIds = [
            'defenceMonsterA', 'defenceMonsterB', 'defenceMonsterC',
            'attackMonsterA', 'attackMonsterB', 'attackMonsterC'
        ];
        let hasError = false;
        requiredIds.forEach(id => {
            const el = document.getElementById(id);
            if (!el.value.trim()) {
                el.classList.add('error');
                hasError = true;
            } else {
                el.classList.remove('error');
            }
        });
        return !hasError;
    }

    // 입력 시 에러 스타일 제거
    inputIds.forEach(id => {
        document.getElementById(id).addEventListener('input', function() {
            if (this.value.trim()) this.classList.remove('error');
        });
    });

    async function submitForm() {
        if (!validateRequiredFields()) {
            return;
        }

        const defenceMonsterA = document.getElementById('defenceMonsterA').value.trim();
        const defenceMonsterB = document.getElementById('defenceMonsterB').value.trim();
        const defenceMonsterC = document.getElementById('defenceMonsterC').value.trim();
        const attackMonsterA = document.getElementById('attackMonsterA').value.trim();
        const attackMonsterB = document.getElementById('attackMonsterB').value.trim();
        const attackMonsterC = document.getElementById('attackMonsterC').value.trim();
        const deckDesc1 = document.getElementById('deckDesc1').value.trim();
        const deckDesc2 = document.getElementById('deckDesc2').value.trim();

        try {
            const response = await fetch('/api/game/deck/register', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    defenceMonsterA,
                    defenceMonsterB,
                    defenceMonsterC,
                    attackMonsterA,
                    attackMonsterB,
                    attackMonsterC,
                    deckDesc1,
                    deckDesc2
                }),
                credentials: 'include'
            });

            const data = await response.json();

            if (data.success) {
                alert(data.message);
                resetForm();
            } else {
                alert(data.message || '등록에 실패했습니다.');
            }
        } catch (error) {
            console.error('Failed to register deck:', error);
            alert('오류가 발생했습니다.');
        }
    }
</script>
</body>
</html>

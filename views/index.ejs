<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/public/favicon.ico" type="image/x-icon">
    <title><%= title %>111</title>
    <link rel="stylesheet" href="/public/css/common/layout.css">
    <link rel="stylesheet" href="/public/css/style.css">
    <link rel="stylesheet" href="/public/css/game.css">
</head>
<body>
    <%- include('partials/header') %>
    <main class="main-content">
        <div class="main-container">
            <div id="patchNoteWrapper" style="width:100%;"></div>
            <% if (content) { %>
                <p class="main-text"><%= content %></p>
            <% } %>
            <% if (typeof images !== 'undefined' && images && images.length > 0) { %>
                <div class="main-images">
                    <% images.forEach(function(img) { %>
                        <a href="/public/image/main/<%= img %>" target="_blank" rel="noopener">
                            <img src="/public/image/main/<%= img %>" alt="메인 이미지">
                        </a>
                    <% }); %>
                </div>
            <% } %>
        </div>
    </main>
</body>
</html>
<script>
    let patchNoteList = [];
    let patchNoteIndex = 0;
    let patchNoteOn = localStorage.getItem('patchNoteToggle') !== 'off';
    let patchNoteOpen = false;

    async function fetchPatchNotes() {
        try {
            const response = await fetch('/api/game/patch-notes', { credentials: 'include' });
            const data = await response.json();
            patchNoteList = data.patchNoteList || [];
            renderPatchNoteWrapper();
        } catch (error) {
            console.error('Failed to fetch patch notes:', error);
        }
    }

    function renderPatchNoteWrapper() {
        const wrapper = document.getElementById('patchNoteWrapper');
        if (!patchNoteList.length) {
            wrapper.innerHTML = '';
            return;
        }

        const toggleHtml = `
            <div style="display:flex; justify-content:flex-end; margin-bottom:8px;">
                <button type="button" class="notice-toggle-btn${patchNoteOn ? ' on' : ''}" id="patchNoteToggleBtn">
                    <span class="notice-toggle-dot"></span>
                    <span id="patchNoteToggleLabel">${patchNoteOn ? '패치노트 ON' : '패치노트 OFF'}</span>
                </button>
            </div>
        `;

        const sectionHtml = `<div id="patchNoteSection" style="width:100%;${patchNoteOn ? '' : 'display:none;'}">
            ${renderPatchNoteCard()}
        </div>`;

        wrapper.innerHTML = toggleHtml + sectionHtml;

        document.getElementById('patchNoteToggleBtn').addEventListener('click', () => {
            patchNoteOn = !patchNoteOn;
            localStorage.setItem('patchNoteToggle', patchNoteOn ? 'on' : 'off');
            document.getElementById('patchNoteSection').style.display = patchNoteOn ? '' : 'none';
            const btn = document.getElementById('patchNoteToggleBtn');
            btn.classList.toggle('on', patchNoteOn);
            document.getElementById('patchNoteToggleLabel').textContent = patchNoteOn ? '패치노트 ON' : '패치노트 OFF';
        });
    }

    function renderPatchNoteCard() {
        const note = patchNoteList[patchNoteIndex];
        if (!note) return '';
        const total = patchNoteList.length;
        const files = note.boardFileList || [];
        const dateStr = note.inputDt
            ? new Date(note.inputDt).toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\. /g, '.').replace(/\.$/, '')
            : '-';
        const imagesHtml = files.length > 0
            ? `<div class="board-images">${files.map(f => `<img src="/public/image/board/${f.filePath}" alt="첨부 이미지" class="board-attach-img">`).join('')}</div>`
            : '';

        return `
            <div class="defence-card ${patchNoteOpen ? 'open' : ''}" id="patchCard" style="width:100%;box-sizing:border-box;" onclick="togglePatchAccordion()">
                <div class="card-header">
                    <div class="board-title-text">${note.boardTitle}</div>
                    <span class="chevron">▼</span>
                </div>
                <div class="accordion-body" id="patchBody">
                    <div class="accordion-inner" style="padding:12px 16px;min-height:50vh;display:flex;flex-direction:column;">
                        <div class="board-meta-row">
                            <span class="board-author">${note.inputMember ? (note.inputMember.nickname || note.inputMember.name || '-') : '-'}</span>
                            <span class="board-date">${dateStr}</span>
                        </div>
                        <div class="board-content-text">${(note.boardContent || '').replace(/\r\n/g, '\n').replace(/\r/g, '\n').trim()}</div>
                        ${imagesHtml}
                        <div style="display:flex;align-items:center;justify-content:center;gap:8px;margin-top:auto;padding-top:12px;" onclick="event.stopPropagation()">
                            <button class="slider-nav-btn" style="flex:unset;width:30%;padding:4px 0;" onclick="changePatchPage(-1)" ${patchNoteIndex === 0 ? 'disabled' : ''}>이전</button>
                            <span style="font-size:12px;color:#888;">${patchNoteIndex + 1} / ${total}</span>
                            <button class="slider-nav-btn" style="flex:unset;width:30%;padding:4px 0;" onclick="changePatchPage(1)" ${patchNoteIndex === total - 1 ? 'disabled' : ''}>다음</button>
                        </div>
                    </div>
                </div>
            </div>
        `;
    }

    function openPatchBody() {
        const body = document.getElementById('patchBody');
        if (!body) return;
        // 닫힘 → 열림 애니메이션 후 none으로 풀어 잘림 방지
        body.style.maxHeight = body.scrollHeight + 'px';
        body.addEventListener('transitionend', function onEnd() {
            body.style.maxHeight = 'none';
            body.removeEventListener('transitionend', onEnd);
        });
    }

    function togglePatchAccordion() {
        const card = document.getElementById('patchCard');
        const body = document.getElementById('patchBody');
        if (patchNoteOpen) {
            body.style.maxHeight = body.scrollHeight + 'px';
            requestAnimationFrame(() => {
                body.style.maxHeight = '0';
                card.classList.remove('open');
                patchNoteOpen = false;
            });
        } else {
            card.classList.add('open');
            patchNoteOpen = true;
            openPatchBody();
        }
    }

    function changePatchPage(direction) {
        const newIndex = patchNoteIndex + direction;
        if (newIndex < 0 || newIndex >= patchNoteList.length) return;
        patchNoteIndex = newIndex;
        document.getElementById('patchNoteSection').innerHTML = renderPatchNoteCard();
        if (patchNoteOpen) {
            const body = document.getElementById('patchBody');
            body.style.transition = 'none';
            body.style.maxHeight = 'none';
            requestAnimationFrame(() => body.style.transition = '');
        }
    }

    fetchPatchNotes();
</script>

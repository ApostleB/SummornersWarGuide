<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/public/favicon.ico" type="image/x-icon">
    <title><%= title %>111</title>
    <link rel="stylesheet" href="/public/css/common/layout.css">
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
    <%- include('partials/header') %>
    <main class="main-content">
        <div class="main-container">
            <% if (content) { %>
                <p class="main-text"><%= content %></p>
            <% } %>
            <% if (typeof images !== 'undefined' && images && images.length > 0) { %>
                <div class="main-images">
                    <% images.forEach(function(img) { %>
                        <a href="/public/image/main/<%= img %>" target="_blank" rel="noopener">
                            <img src="/public/image/main/<%= img %>" alt="메인 이미지">
                        </a>
                    <% }); %>
                </div>
            <% } %>
        </div>
    </main>
</body>
</html>
<script>
    <% if (user) { %>
        // location.href="/game/defence";
    <% } %>
</script>

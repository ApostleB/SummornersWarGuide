<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/public/favicon.ico" type="image/x-icon">
    <title><%= title %>111</title>
    <link rel="stylesheet" href="/public/css/common/layout.css">
    <link rel="stylesheet" href="/public/css/style.css">
    <style>
        .main-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 40px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 24px;
        }
        .main-text {
            width: 100%;
            font-size: 15px;
            color: #4a5568;
            line-height: 1.8;
            text-align: center;
            white-space: pre-wrap;
            word-break: break-word;
        }
        .main-images {
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
        }
        .main-images img {
            width: 100%;
            max-width: 700px;
            border-radius: 12px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.1);
            display: block;
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>
    <main class="main-content">
        <div class="main-container">
            <% if (content) { %>
                <p class="main-text"><%= content %></p>
            <% } %>
            <% if (typeof images !== 'undefined' && images && images.length > 0) { %>
                <div class="main-images">
                    <% images.forEach(function(img) { %>
                        <a href="/public/image/main/<%= img %>" target="_blank" rel="noopener">
                            <img src="/public/image/main/<%= img %>" alt="메인 이미지">
                        </a>
                    <% }); %>
                </div>
            <% } %>
        </div>
    </main>
</body>
</html>
<script>
    <% if (user) { %>
        // location.href="/game/defence";
    <% } %>
</script>

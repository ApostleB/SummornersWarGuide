<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/public/favicon.ico" type="image/x-icon">
    <title>관리자 - 패치노트 관리</title>
    <link rel="stylesheet" href="/public/css/common/layout.css">
    <link rel="stylesheet" href="/public/css/style.css">
    <link rel="stylesheet" href="/public/css/admin.css">
    <link rel="stylesheet" href="/public/css/admin/code.css">
    <link rel="stylesheet" href="/public/css/admin/board.css">
</head>
<body>
<%- include('../../partials/header') %>

<main class="main-content">
    <div class="admin-container">
        <div class="page-header">
            <h1 class="page-title">패치노트 관리</h1>
            <p class="page-desc">게임 업데이트 및 패치노트를 관리합니다</p>
        </div>

        <div class="code-container">
            <!-- 게시글 목록 -->
            <div class="dtl-panel">
                <div class="dtl-header">
                    <div class="dtl-title">패치노트 목록</div>
                    <button class="btn-primary" onclick="openAddForm()">+ 패치노트 추가</button>
                </div>

                <div class="dtl-list" id="boardListContainer">
                    <div class="empty-state">목록을 불러오는 중...</div>
                </div>

                <!-- 게시글 추가/수정 폼 -->
                <div class="edit-panel" id="editPanel" style="display:none;">
                    <div class="edit-panel-title" id="editPanelTitle">패치노트 추가</div>
                    <input type="hidden" id="editBoardId">
                    <div class="form-grid">
                        <div class="form-group">
                            <label>제목 *</label>
                            <input type="text" id="editBoardTitle" placeholder="패치노트 제목">
                        </div>
                        <div class="form-group">
                            <label>순서</label>
                            <input type="number" id="editBoardOrder" placeholder="0" min="0">
                        </div>
                        <div class="form-group">
                            <label>사용여부</label>
                            <select id="editUseYn">
                                <option value="Y">사용</option>
                                <option value="N">미사용</option>
                            </select>
                        </div>
                        <div class="form-group full-width">
                            <label>내용 *</label>
                            <textarea id="editBoardContent" placeholder="내용을 입력하세요" style="min-height: 120px;"></textarea>
                        </div>
                        <div class="form-group full-width">
                            <label>이미지 <span id="imageCountBadge" class="image-count-badge">(0 / 5)</span></label>
                            <!-- 이미지 미리보기 (기존 + 신규 통합) -->
                            <div id="allImagesPreview" class="board-images-preview"></div>
                            <!-- 드래그&드랍 / 파일 선택 영역 -->
                            <div class="drop-zone" id="dropZone">
                                <div>🖼 이미지를 드래그하거나 클릭하여 추가</div>
                                <div class="drop-hint">PNG, JPG, GIF · 최대 5개</div>
                            </div>
                            <input type="file" id="boardImageInput" accept="image/*" multiple style="display:none;">
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn-secondary" onclick="closeEditPanel()">취소</button>
                        <button class="btn-primary" onclick="saveBoard()">저장</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<script>
    const BOARD_TYPE = 'PATCH';
    const MAX_IMAGES = 5;
    let editMode = 'add';
    let pendingDeleteFileIds = [];
    let newImageFiles = [];       // 새로 추가할 File 객체 배열
    let existingFileItems = [];   // { fileId, filePath } 형태의 기존 파일 배열

    document.addEventListener('DOMContentLoaded', () => {
        fetchBoardList();
        initDropZone();
    });

    function initDropZone() {
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('boardImageInput');

        dropZone.addEventListener('click', () => fileInput.click());

        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.classList.add('drag-over');
        });
        dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));
        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('drag-over');
            addImageFiles(Array.from(e.dataTransfer.files).filter(f => f.type.startsWith('image/')));
        });

        fileInput.addEventListener('change', (e) => {
            addImageFiles(Array.from(e.target.files));
            e.target.value = '';
        });
    }

    function addImageFiles(files) {
        const totalAfter = existingFileItems.length + newImageFiles.length + files.length;
        if (totalAfter > MAX_IMAGES) {
            const canAdd = MAX_IMAGES - existingFileItems.length - newImageFiles.length;
            alert(`이미지는 최대 ${MAX_IMAGES}개까지 업로드할 수 있습니다. (${canAdd}개 더 추가 가능)`);
            files = files.slice(0, canAdd);
            if (files.length === 0) return;
        }
        newImageFiles = newImageFiles.concat(files);
        renderAllImages();
    }

    function renderAllImages() {
        const container = document.getElementById('allImagesPreview');
        const existingHtml = existingFileItems.map(f => `
            <div class="board-image-item" id="existing-img-${f.fileId}">
                <img src="/public/image/board/${f.filePath}" alt="이미지">
                <button class="btn-remove-img" onclick="removeExistingImage('${f.fileId}')">×</button>
            </div>`).join('');
        const newHtml = newImageFiles.map((file, idx) => {
            const url = URL.createObjectURL(file);
            return `
            <div class="board-image-item" id="new-img-${idx}">
                <img src="${url}" alt="새 이미지">
                <button class="btn-remove-img" onclick="removeNewImage(${idx})">×</button>
            </div>`;
        }).join('');
        container.innerHTML = existingHtml + newHtml;
        updateImageCount();
    }

    function updateImageCount() {
        const total = existingFileItems.length + newImageFiles.length;
        const badge = document.getElementById('imageCountBadge');
        badge.textContent = `(${total} / ${MAX_IMAGES})`;
        badge.style.color = total >= MAX_IMAGES ? '#e53e3e' : '#888';

        const dropZone = document.getElementById('dropZone');
        dropZone.style.opacity = total >= MAX_IMAGES ? '0.4' : '1';
        dropZone.style.pointerEvents = total >= MAX_IMAGES ? 'none' : 'auto';
    }

    function removeExistingImage(fileId) {
        pendingDeleteFileIds.push(fileId);
        existingFileItems = existingFileItems.filter(f => f.fileId !== fileId);
        renderAllImages();
    }

    function removeNewImage(idx) {
        newImageFiles.splice(idx, 1);
        renderAllImages();
    }

    async function fetchBoardList() {
        try {
            const response = await fetch(`/api/admin/board/list/${BOARD_TYPE}`, { credentials: 'include' });
            const data = await response.json();
            renderBoardList(data.getBoardList);
        } catch (error) {
            console.error('Failed to fetch board list:', error);
        }
    }

    function renderBoardList(boardList) {
        const container = document.getElementById('boardListContainer');
        if (!boardList || boardList.length === 0) {
            container.innerHTML = '<div class="empty-state">등록된 패치노트가 없습니다</div>';
            return;
        }

        container.innerHTML = `
            <table class="dtl-table">
                <thead>
                    <tr>
                        <th style="width:50px;">순서</th>
                        <th>제목</th>
                        <th style="width:70px;">이미지</th>
                        <th style="width:70px;">사용</th>
                        <th style="width:80px;">등록일</th>
                        <th style="width:90px;">관리</th>
                    </tr>
                </thead>
                <tbody>
                    ${boardList.map(board => {
                        const activeFiles = (board.boardFileList || []).filter(f => f.delYn !== 'Y');
                        // const thumbsHtml = activeFiles.map(f =>
                        //     `<img src="/public/image/board/${f.filePath}" alt="이미지">`
                        // ).join('');
                        return `
                        <tr id="row-${board.boardId}" data-board='${JSON.stringify(board).replace(/'/g, "&#39;")}'>
                            <td style="text-align:center;">${board.boardOrder ?? 0}</td>
                            <td><strong>${board.boardTitle || '-'}</strong></td>
                            <td>
                                <div class="board-images-thumb">${activeFiles.length || '-'}</div>
                            </td>
                            <td><span class="badge badge-${board.useYn.toLowerCase()}">${board.useYn === 'Y' ? '사용' : '미사용'}</span></td>
                            <td style="font-size:11px;">${board.inputDt ? new Date(board.inputDt).toLocaleDateString('ko-KR') : '-'}</td>
                            <td>
                                <button class="btn-icon btn-edit" onclick="editBoard('${board.boardId}')">수정</button>
                                <button class="btn-icon btn-delete" onclick="deleteBoard('${board.boardId}')">삭제</button>
                            </td>
                        </tr>`;
                    }).join('')}
                </tbody>
            </table>
        `;
    }

    function resetImageState() {
        pendingDeleteFileIds = [];
        newImageFiles = [];
        existingFileItems = [];
        document.getElementById('allImagesPreview').innerHTML = '';
        updateImageCount();
    }

    function openAddForm() {
        editMode = 'add';
        resetImageState();
        document.getElementById('editPanelTitle').textContent = '패치노트 추가';
        document.getElementById('editBoardId').value = '';
        document.getElementById('editBoardTitle').value = '';
        document.getElementById('editBoardContent').value = '';
        document.getElementById('editBoardOrder').value = '0';
        document.getElementById('editUseYn').value = 'Y';
        document.getElementById('editPanel').style.display = 'block';
        document.getElementById('editPanel').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function editBoard(boardId) {
        const row = document.getElementById(`row-${boardId}`);
        const board = JSON.parse(row.dataset.board);

        editMode = 'edit';
        resetImageState();
        document.getElementById('editPanelTitle').textContent = '패치노트 수정';
        document.getElementById('editBoardId').value = board.boardId;
        document.getElementById('editBoardTitle').value = board.boardTitle || '';
        document.getElementById('editBoardContent').value = board.boardContent || '';
        document.getElementById('editBoardOrder').value = board.boardOrder ?? 0;
        document.getElementById('editUseYn').value = board.useYn;

        existingFileItems = (board.boardFileList || [])
            .filter(f => f.delYn !== 'Y')
            .map(f => ({ fileId: f.fileId, filePath: f.filePath }));
        renderAllImages();

        document.querySelectorAll('.dtl-table tr').forEach(tr => tr.classList.remove('selected'));
        row.classList.add('selected');
        document.getElementById('editPanel').style.display = 'block';
        document.getElementById('editPanel').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function closeEditPanel() {
        document.getElementById('editPanel').style.display = 'none';
        document.querySelectorAll('.dtl-table tr').forEach(tr => tr.classList.remove('selected'));
    }

    async function saveBoard() {
        const boardTitle = document.getElementById('editBoardTitle').value.trim();
        const boardContent = document.getElementById('editBoardContent').value.trim();
        const boardOrder = parseInt(document.getElementById('editBoardOrder').value) || 0;
        const useYn = document.getElementById('editUseYn').value;

        if (!boardTitle || !boardContent) {
            alert('제목과 내용은 필수입니다.');
            return;
        }

        const formData = new FormData();
        formData.append('boardType', BOARD_TYPE);
        formData.append('boardTitle', boardTitle);
        formData.append('boardContent', boardContent);
        formData.append('boardOrder', boardOrder);
        formData.append('useYn', useYn);

        // 삭제할 파일 ID
        pendingDeleteFileIds.forEach(id => formData.append('deleteFileIds', id));

        // 새 이미지 파일
        newImageFiles.forEach(file => formData.append('boardImages', file));

        try {
            let response;
            if (editMode === 'add') {
                response = await fetch('/api/admin/board', {
                    method: 'POST',
                    body: formData,
                    credentials: 'include'
                });
            } else {
                const boardId = document.getElementById('editBoardId').value;
                response = await fetch(`/api/admin/board/${boardId}`, {
                    method: 'PUT',
                    body: formData,
                    credentials: 'include'
                });
            }

            if (response.ok) {
                alert(editMode === 'add' ? '패치노트가 추가되었습니다.' : '패치노트가 수정되었습니다.');
                closeEditPanel();
                fetchBoardList();
            } else {
                alert('저장에 실패했습니다.');
            }
        } catch (error) {
            console.error('Failed to save board:', error);
            alert('오류가 발생했습니다.');
        }
    }

    async function deleteBoard(boardId) {
        if (!confirm('이 패치노트를 삭제하시겠습니까?')) return;

        try {
            const response = await fetch(`/api/admin/board/${boardId}`, {
                method: 'DELETE',
                credentials: 'include'
            });

            if (response.ok) {
                alert('패치노트가 삭제되었습니다.');
                fetchBoardList();
                closeEditPanel();
            } else {
                alert('삭제에 실패했습니다.');
            }
        } catch (error) {
            console.error('Failed to delete board:', error);
            alert('오류가 발생했습니다.');
        }
    }
</script>
</body>
</html>
